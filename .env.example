# ==============================================================================
# Universal Data Engineering Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# NOTE: The pipeline is fully functional out-of-the-box without PostgreSQL!
# If DATABASE_URL is omitted or the database is unreachable, all stages run
# cleanly using local validated file caches and dynamic schemas.
# ==============================================================================

# PostgreSQL Relational Warehouse URL (Optional)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/universal_pipeline

# Web Dashboard Port (Optional, default is 5000)
# PORT=5000
